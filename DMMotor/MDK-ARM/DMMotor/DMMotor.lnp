--cpu Cortex-M3
"dmmotor\startup_stm32f103xb.o"
"dmmotor\main.o"
"dmmotor\gpio.o"
"dmmotor\can.o"
"dmmotor\usart.o"
"dmmotor\stm32f1xx_it.o"
"dmmotor\stm32f1xx_hal_msp.o"
"dmmotor\stm32f1xx_hal_gpio_ex.o"
"dmmotor\stm32f1xx_hal_can.o"
"dmmotor\stm32f1xx_hal.o"
"dmmotor\stm32f1xx_hal_rcc.o"
"dmmotor\stm32f1xx_hal_rcc_ex.o"
"dmmotor\stm32f1xx_hal_gpio.o"
"dmmotor\stm32f1xx_hal_dma.o"
"dmmotor\stm32f1xx_hal_cortex.o"
"dmmotor\stm32f1xx_hal_pwr.o"
"dmmotor\stm32f1xx_hal_flash.o"
"dmmotor\stm32f1xx_hal_flash_ex.o"
"dmmotor\stm32f1xx_hal_exti.o"
"dmmotor\stm32f1xx_hal_tim.o"
"dmmotor\stm32f1xx_hal_tim_ex.o"
"dmmotor\stm32f1xx_hal_uart.o"
